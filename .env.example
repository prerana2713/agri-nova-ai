# Agri Nova AI Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to version control.

# Flask session signing key (leave blank to auto-generate a local key in instance/.secret_key)
SECRET_KEY=

# Optional OpenWeatherMap API key for live weather data (https://openweathermap.org/api)
# If omitted, the Weather page automatically runs in clearly labeled Demo Mode.
OPENWEATHER_API_KEY=

# Optional shared secret header (X-Device-Token) for POST /api/iot/ingest
IOT_DEVICE_TOKEN=

